[Unit]
Description=Field Emailer PWA static server
After=network.target
Wants=network.target
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
WorkingDirectory=/opt/emailassist
ExecStart=/usr/bin/node /opt/emailassist/server.js
Environment=PORT=3000
Restart=always
RestartSec=3
User=dasadmin
Group=dasadmin
StandardOutput=append:/var/log/emailer.log
StandardError=append:/var/log/emailer.log

[Install]
WantedBy=multi-user.target
